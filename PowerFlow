import numpy as np
import math
from Jacobian import Jacobian

class PowerFlow:
    """
    Newton-Raphson Power Flow Solver.
    Implements Milestone 8 iterative solver using power mismatches and Jacobian matrix.
    """
    def __init__(self, circuit):
        """
        Stores the reference to the main circuit object to access the mismatch calculation.
        """
        self.circuit = circuit

    def solve(self, buses, ybus, tol=0.001, max_iter=50):
        """
        Iteratively solves for bus voltage magnitudes and angles.
        Method signature matches Milestone 8 exact requirements.
        """
        print("--- Starting Newton-Raphson Power Flow ---")
        print(f"Tolerance: {tol} | Max Iterations: {max_iter}\n")

        # Step 2: Initialize Variables (Flat Start)
        # All angles = 0 degrees; PQ bus voltage magnitudes = 1.0 pu.
        for bus in buses.values():
            if bus.bus_type != "Slack":
                bus.delta = 0.0
                # PV bus voltage is fixed by generator setpoint, only initialize PQ
                if bus.bus_type == "PQ":
                    bus.vpu = 1.0

        iteration = 0
        converged = False

        # Step 3: Iterative Solution Loop
        while iteration < max_iter:
            # Step 1: Use Milestone 6's power mismatch function to calculate f
            f = self.circuit.compute_power_mismatch()
            
            # Step 5: Check convergence BEFORE solving linear system
            max_mismatch = np.max(np.abs(f))
            print(f"Iteration {iteration}: Max Mismatch = {max_mismatch:.6f}")
            
            if max_mismatch < tol:
                converged = True
                break

            # Step 2: Use Milestone 7's Jacobian class to compute Jacobian matrix J
            jac_generator = Jacobian(buses, ybus)
            J = jac_generator.calc_jacobian()

            # Step 3: Solve the linear system J * dx = f
            try:
                dx = np.linalg.solve(J, f)
            except np.linalg.LinAlgError:
                print("Error: Jacobian matrix is singular. Solution failed.")
                return False

            # Step 4: Update voltages and angles
            # Identify bus types to properly map dx vector to correct state variables
            p_buses = [b for b in buses.values() if b.bus_type != "Slack"]
            q_buses = [b for b in buses.values() if b.bus_type == "PQ"]
            
            num_angles = len(p_buses)

            # Update angles (delta) for all non-slack buses (PV and PQ)
            for i, bus in enumerate(p_buses):
                bus.delta += dx[i]

            # Update voltage magnitudes (|V|) for PQ buses only
            for i, bus in enumerate(q_buses):
                bus.vpu += dx[num_angles + i]

            iteration += 1

        # Step 6: If max iterations are exceeded, report non-convergence
        if converged:
            print(f"\nConvergence achieved in {iteration} iterations.")
            self.display_results(buses)
        else:
            print(f"\nNon-convergence: Maximum iterations ({max_iter}) reached without dropping below tolerance.")
        
        return converged

    def display_results(self, buses):
        """
        Outputs final voltage magnitudes and angles per bus in a formatted table.
        """
        print("\n" + "="*50)
        print(f"{'Bus Name':<15} | {'V (pu)':<12} | {'Angle (deg)':<12}")
        print("-" * 50)
        for name, bus in buses.items():
            angle_deg = math.degrees(bus.delta)
            print(f"{name:<15} | {bus.vpu:<12.4f} | {angle_deg:<12.4f}")
        print("="*50 + "\n")
